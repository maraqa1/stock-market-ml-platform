[Unit]
Description=Prune old StockML generated artifacts
After=stockml-full-nightly.service

[Service]
Type=oneshot
WorkingDirectory=/home/massa/stock-market-ml-platform
Environment=PYTHONPATH=/home/massa/stock-market-ml-platform/src
EnvironmentFile=-/etc/stockml/stockml.env
ExecStart=/opt/jupyter-env/bin/python3 /home/massa/stock-market-ml-platform/scripts/cleanup_pipeline_artifacts.py --execute
