[Unit]
Description=StockML full nightly research pipeline
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/massa/stock-market-ml-platform
Environment=PYTHONPATH=/home/massa/stock-market-ml-platform/src
Environment=STOCKML_PROFILE=nasdaq_500
ExecStart=/bin/bash -lc '/opt/jupyter-env/bin/python3 /home/massa/stock-market-ml-platform/scripts/run_profile_pipeline.py --profile "${STOCKML_PROFILE}"'
