# Copy this file to .env on the VM and edit the password.
# .env is intentionally ignored by git because it contains secrets.

STOCKML_DB_NAME=stockml
STOCKML_DB_USER=stockml
STOCKML_DB_PASSWORD=change-this-password
STOCKML_DB_HOST=localhost
STOCKML_DB_PORT=5432

STOCKML_PROFILE=nasdaq_500
STOCKML_WRITE_DATABASE=1
PORT=8091

# Optional. If blank, deployment/vm/install_database.sh builds it from the fields above.
# DATABASE_URL=postgresql+psycopg2://stockml:change-this-password@localhost:5432/stockml

# Alpaca paper trading. Keep submit false until order plans are reviewed.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
STOCKML_ALPACA_AUTOTRADE_ENABLED=true
STOCKML_ALPACA_SUBMIT_ORDERS=false
STOCKML_ALPACA_EXTENDED_HOURS=false
STOCKML_ALPACA_AUTOTRADE_START_UTC=14:45
STOCKML_ALPACA_AUTOTRADE_END_UTC=20:30
STOCKML_ALPACA_IGNORE_TRADE_WINDOW=false
STOCKML_ALPACA_MAX_ORDERS=10
STOCKML_CANDIDATE_POOL_SIZE=50
STOCKML_ALPACA_MAX_NOTIONAL_PER_ORDER=1000
STOCKML_ALPACA_MAX_TOTAL_NOTIONAL=10000
STOCKML_ALPACA_MIN_TRADE_PRICE=5
STOCKML_ALPACA_MAX_SECTOR_FRACTION=0.4
STOCKML_ALPACA_MIN_SIDE_PROBABILITY=0.55
STOCKML_ALPACA_MIN_ABS_PROBABILITY_EDGE=0.05
STOCKML_ALPACA_MIN_INTRADAY_VOLUME=100000
STOCKML_ALPACA_MIN_MARKET_CAP=300000000
STOCKML_ALPACA_MIN_RISK_ADJUSTED_SCORE=0.001
STOCKML_ALPACA_TRANSACTION_COST_BPS=10
STOCKML_ALLOW_SHORT_SELLING=false
STOCKML_ALLOW_DIAGNOSTIC_PAPER_TRADES=false

# Optional tracking refresh. Use after a paper order run to update order statuses and positions.
# /opt/jupyter-env/bin/python3 scripts/run_alpaca_paper_trader.py --track-only
